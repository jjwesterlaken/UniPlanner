{
  "name": "university-planner",
  "productName": "University Planner",
  "version": "1.1.0",
  "description": "Plan courses, assignments, readings and study cards.",
  "main": "main.js",
  "author": "University Planner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjwesterlaken/UniPlanner.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.uniplannerapp.planner",
    "productName": "University Planner",
    "files": [
      "main.js",
      "www/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "University-Planner.${ext}",
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "University Planner uses your microphone to record lectures so it can generate an AI summary and study cards. Your recording is sent to Groq for transcription and is deleted the moment it's transcribed."
      }
    },
    "dmg": {
      "title": "University Planner",
      "artifactName": "University-Planner.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "University Planner",
      "artifactName": "University-Planner-Setup.${ext}"
    },
    "portable": {
      "artifactName": "University-Planner-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "University-Planner.${ext}"
    }
  }
}
