{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-dirty-checkout.mjs",
            "timeout": 10,
            "statusMessage": "Checking for uncommitted work"
          }
        ]
      }
    ]
  }
}
