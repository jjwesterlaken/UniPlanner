node_modules/
dist-web/
dist-site/
desktop/www/
mobile/www/
# Generated per machine by `cap add` — and regenerated freely, which is why
# the mic permission is re-applied by a script rather than committed here.
mobile/ios/
mobile/android/
.ai-notes-test-tmp/
.claude/

# Release signing secrets. The keystore must live OUTSIDE the repo; these
# entries are the backstop for the day someone creates one inside it and
# runs `git add -A`. A test asserts they are present AND that git really
# ignores a file at each of these paths -- an entry can be present and
# still not bite, which is the only failure mode a text check cannot see.
*.jks
*.keystore
key.properties

# A real lecture transcript, pasted in to run scripts/measure-summary-depth.mjs.
# It is a student's content and a lecturer's copyrighted delivery, and the
# script takes it as a path argument, so the obvious place to put one is the
# repository root. Ignored for the same reason as the keystore: the normal way
# work gets committed here is `git add -A`.
transcript.txt

.archive-test-tmp/
# e2e journey artifacts (per-run)
e2e/.state.json
e2e/test-results/

# c8 writes one JSON file per forked test process into coverage/tmp on
# every `npm run test:coverage`. Thirty of them were committed by PR #50
# and carried through two more, because `git add -A` is how work gets
# committed here and nothing was ignoring them -- the same mechanism as
# the keystore entries above, with a harmless payload instead of a
# catastrophic one. They are pure build output: the gate reads the
# `text` reporter's stdout, not these files.
coverage/
